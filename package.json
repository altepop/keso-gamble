{
  "name": "keso-exchange",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "start": "python3 -m http.server 8000",
    "test:browser": "node scripts/browser-check.cjs",
    "results:check": "npm --prefix services/valorant-results run check",
    "results:build": "npm --prefix services/valorant-results run build",
    "build:discord": "node scripts/build-discord-sdk.mjs",
    "check:discord": "node scripts/build-discord-sdk.mjs --check",
    "test:casino-browser": "node scripts/casino-browser-check.cjs",
    "test:stock-browser": "node scripts/stock-browser-check.cjs"
  },
  "dependencies": {
    "@discord/embedded-app-sdk": "2.5.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
