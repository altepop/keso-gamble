{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "valorant-results-example",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-24",
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "valorant-results",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "VOICE_GATEWAY",
        "class_name": "VoiceGateway"
      },
      {
        "name": "RACE_BROADCAST",
        "class_name": "RaceBroadcaster"
      }
    ]
  },
  "migrations": [
    {
      "tag": "voice-v1",
      "new_sqlite_classes": [
        "VoiceGateway"
      ]
    },
    {
      "tag": "race-broadcast-v1",
      "new_sqlite_classes": [
        "RaceBroadcaster"
      ]
    }
  ]
}
